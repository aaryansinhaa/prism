# ==============================================================================
# PRISM Configuration Settings Template
# Copy this file to '.env' and modify the values as needed.
# ==============================================================================

# Directory where uploaded ML model files and build contexts are stored.
# Default: model_store/uploads
# MODEL_UPLOAD_ROOT=model_store/uploads

# Path to the JSON registry file that stores container and version metadata.
# Default: app/registry/containers.json
# MODEL_CONTAINER_REGISTRY_PATH=app/registry/containers.json

# If set to true, only one model container remains active at any given time.
# Starting a new container will stop any currently running model containers.
PRISM_SINGLE_ACTIVE_MODEL=true

# Enables the background health monitoring service.
PRISM_ENABLE_HEALTH_MONITOR=true

# Interval in seconds between background health monitoring cycles.
PRISM_HEALTH_MONITOR_INTERVAL_SECONDS=10

# Comma-separated list of valid API keys for protecting the /models/{model_id}/predict endpoint.
# If not configured, predictions run in open access mode.
# PRISM_API_KEYS=key-one,key-two

# Rate limiting settings for public inference endpoints.
PRISM_RATE_LIMIT_REQUESTS=120
PRISM_RATE_LIMIT_WINDOW_SECONDS=60

# Max delay in milliseconds to accumulate incoming requests for batch processing.
PRISM_BATCH_WINDOW_MS=50

# --- Reverse Tunnel Settings (Optional) ---

# Enables automatic creation of public ngrok tunnels for deployed models.
ENABLE_TUNNEL=false

# Your personal ngrok authtoken, required when ENABLE_TUNNEL is set to true.
# NGROK_AUTHTOKEN=your-ngrok-authtoken-here

# Timeout in seconds for ngrok tunnel establishment.
PRISM_TUNNEL_START_TIMEOUT=30
